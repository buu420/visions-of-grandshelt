-MH_STATUS WINAPI MH_CreateHook(LPVOID pTarget, LPVOID pDetour, LPVOID *ppOriginal)
+// The caller supplies complete, exact-build-verified instructions with no
+// position-dependent operands and their instruction boundaries.
+static BOOL CreateAbsoluteTrampoline(PTRAMPOLINE ct, const UINT8* offsets, UINT count)
+{
+#if defined(_M_X64) || defined(__x86_64__)
+    UINT size, i;
+    if (count < 2 || count > ARRAYSIZE(ct->oldIPs) || offsets[0] != 0)
+        return FALSE;
+    size = offsets[count - 1];
+    if (size < sizeof(JMP_ABS) || size + 2 * sizeof(JMP_ABS) > MEMORY_SLOT_SIZE)
+        return FALSE;
+    for (i = 1; i < count; ++i)
+    {
+        if (offsets[i] <= offsets[i - 1] || offsets[i] - offsets[i - 1] > 15)
+            return FALSE;
+    }
+
+    {
+        const JMP_ABS resume = {0xFF, 0x25, 0, (ULONG_PTR)ct->pTarget + size};
+        const JMP_ABS relay = {0xFF, 0x25, 0, (ULONG_PTR)ct->pDetour};
+        LPBYTE code = (LPBYTE)ct->pTrampoline;
+        ct->patchAbove = FALSE;
+        ct->nIP = count;
+        memcpy(ct->oldIPs, offsets, count);
+        memcpy(ct->newIPs, offsets, count);
+        memcpy(code, ct->pTarget, size);
+        memcpy(code + size, &resume, sizeof(resume));
+        ct->pRelay = code + size + sizeof(resume);
+        memcpy(ct->pRelay, &relay, sizeof(relay));
+        return FlushInstructionCache(GetCurrentProcess(), code, size + sizeof(resume) + sizeof(relay));
+    }
+#else
+    return FALSE;
+#endif
+}
