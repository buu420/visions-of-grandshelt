function(resonance_dwm_exports source output)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
  file(STRINGS "${source}" exports REGEX "^[0-9]")
  set(definition "LIBRARY dwmapi\nEXPORTS\n")
  set(entries "")
  set(stubs "")
  set(index 0)
  foreach(export IN LISTS exports)
    if(NOT export MATCHES "^([0-9]+)( ([A-Za-z_][A-Za-z0-9_]*))?$")
      message(FATAL_ERROR "Invalid DWM export: ${export}")
    endif()
    set(ordinal "${CMAKE_MATCH_1}")
    set(name "${CMAKE_MATCH_3}")
    set(stub "DwmProxy${ordinal}")
    if(name)
      set(visibility "")
      if(name STREQUAL "DllCanUnloadNow" OR name STREQUAL "DllGetClassObject")
        set(visibility " PRIVATE")
      endif()
      string(APPEND definition "    ${name}=${stub} @${ordinal}${visibility}\n")
      string(APPEND entries "    {\"${name}\", ${ordinal}},\n")
    else()
      string(APPEND definition "    ${stub} @${ordinal} NONAME\n")
      string(APPEND entries "    {nullptr, ${ordinal}},\n")
    endif()
    string(APPEND stubs "PUBLIC ${stub}\n${stub} PROC\n    mov r10d, ${index}\n    jmp DwmDispatch\n${stub} ENDP\n")
    math(EXPR index "${index} + 1")
  endforeach()
  file(MAKE_DIRECTORY "${output}")
  file(CONFIGURE OUTPUT "${output}/dwmapi.def" CONTENT "@definition@" @ONLY)
  file(CONFIGURE OUTPUT "${output}/DwmApiExports.inc" CONTENT "@entries@" @ONLY)
  file(CONFIGURE OUTPUT "${output}/DwmApiStubs.inc" CONTENT "@stubs@" @ONLY)
endfunction()
